NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Solo servidor / admin (nunca exponer al browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Verificación de Google Search Console (meta google-site-verification).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# ID de medición de Google Analytics 4, formato G-XXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Demo sin Supabase (mock + admin abierto). En producción: false u omitir.
# En `next dev` el mock ya está permitido sin esta flag.
ALLOW_DEMO_MODE=false

# Misma planilla que RG Motors. Inventario de Salgado = pestaña SALGADO AUTOMOTRIZ.
GOOGLE_SHEET_ID=1BG2uR6APbXEMvVvRmdR-Nn0Vko6eobJ6Xam0XX41Ldc
SALGADO_SHEET_TAB=SALGADO AUTOMOTRIZ
# Carpeta pública "FOTOS" (subcarpetas "ID 328", etc.) enlazada en esa pestaña.
DRIVE_PHOTOS_FOLDER_ID=1T_FkTaF9rFf97kM14MvdYzJHSYg-WLgo

# Correo de consignaciones (opcional). Sin esto la solicitud igual se guarda en Supabase.
RESEND_API_KEY=
CONSIGNA_TO=contacto@salgadoautomotriz.cl
CONSIGNA_FROM=Salgado Automotriz <noreply@salgadoautomotriz.cl>
