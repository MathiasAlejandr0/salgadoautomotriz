NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Solo servidor. Nunca uses el prefijo NEXT_PUBLIC_ ni lo importes en componentes cliente.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL canónica (sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://salgadoautomotriz.cl

# TODO(dueño): WhatsApp real. Solo dígitos, con código de país. Sin esto el sitio
# muestra el placeholder +56 9 1234 5678, que NO es el número del negocio.
NEXT_PUBLIC_WHATSAPP_E164=
# Texto visible del teléfono. Si se omite, se formatea a partir del E164.
NEXT_PUBLIC_PHONE_DISPLAY=

# Nota de Google. Déjalas vacías hasta confirmar el dato real en Google.
# NEXT_PUBLIC_GOOGLE_RATING=4.9
# NEXT_PUBLIC_GOOGLE_RATING_COUNT=120

# Verificación de Google Search Console (meta google-site-verification).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# ID de medición de Google Analytics 4, formato G-XXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Demo sin Supabase (mock + admin abierto). Se ignora cuando NODE_ENV=production,
# incluido el preview de Vercel. En `next dev` el mock ya está permitido sin esta flag.
ALLOW_DEMO_MODE=false

# Misma planilla que RG Motors. Inventario de Salgado = pestaña SALGADO AUTOMOTRIZ.
GOOGLE_SHEET_ID=1BG2uR6APbXEMvVvRmdR-Nn0Vko6eobJ6Xam0XX41Ldc
SALGADO_SHEET_TAB=SALGADO AUTOMOTRIZ
# Carpeta pública "FOTOS" (subcarpetas "ID 328", etc.) enlazada en esa pestaña.
DRIVE_PHOTOS_FOLDER_ID=1T_FkTaF9rFf97kM14MvdYzJHSYg-WLgo

# Correo de consignaciones (opcional). Sin Resend, la solicitud se guarda en Supabase.
RESEND_API_KEY=
CONSIGNA_TO=contacto@salgadoautomotriz.cl
CONSIGNA_FROM=Salgado Automotriz <noreply@salgadoautomotriz.cl>
