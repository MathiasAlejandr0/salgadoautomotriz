# Fotos subidas: nunca se ejecuta código aquí.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|shtml|htaccess)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(?i:jpe?g|png|webp)$">
  Header set X-Content-Type-Options "nosniff"
</FilesMatch>