  RewriteRule ^catalogo/detalle/dongfeng-db200zh-2024-zrf009$ /catalogo/detalle/dongfeng-db200zh-blanco-2024-107 [R=301,L]
  RewriteRule ^catalogo/detalle/chevrolet-spark-gt-lt-12-2016-hlxb59$ /catalogo/detalle/chevrolet-spark-gt-lt-12-verde-cocktail-2016-300 [R=301,L]
  RewriteRule ^catalogo/detalle/jac-t6-2020-lwrs59$ /catalogo/detalle/jac-t6-plateado-plata-2020-280 [R=301,L]
  RewriteRule ^catalogo/detalle/ford-edge-20-aut-2017-jrth26$ /catalogo/detalle/ford-edge-20-aut-negro-2017-179 [R=301,L]
  RewriteRule ^catalogo/detalle/mg-zs-2024-trbx87$ /catalogo/detalle/mg-zs-gris-plata-2024-323 [R=301,L]
