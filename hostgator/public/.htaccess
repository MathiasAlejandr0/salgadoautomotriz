  RewriteRule ^catalogo/detalle/peugeot-partner-2022$ /catalogo/detalle/peugeot-partner-blanca-2022-9 [R=301,L]
  RewriteRule ^catalogo/detalle/mitsubishi-l200-katana-crt-4x4-2018$ /catalogo/detalle/mitsubishi-l200-katana-crt-4x4-rojo-2018-naf9d63 [R=301,L]
  RewriteRule ^catalogo/detalle/hyundai-gran-i10-blanco-2022-35$ /catalogo/detalle/hyundai-gran-i10-blanco-2022-89 [R=301,L]
  RewriteRule ^catalogo/detalle/toyota-hilux-4x2-rojo-2023-3$ /catalogo/detalle/toyota-hilux-4x2-rojo-2023-33 [R=301,L]
  RewriteRule ^catalogo/detalle/hyundai-porter-blanco-2022-24$ /catalogo/detalle/hyundai-porter-blanco-2022-28 [R=301,L]
  RewriteRule ^catalogo/detalle/suzuki-jimny-mt-4x4-15-gris-2023-18$ /catalogo/detalle/suzuki-jimny-mt-4x4-15-gris-2023-11 [R=301,L]
  RewriteRule ^catalogo/detalle/great-wall-wingle-5-blanco-2020-37$ /catalogo/detalle/great-wall-wingle-5-blanco-2020-nc0bda0 [R=301,L]
  RewriteRule ^catalogo/detalle/toyota-hilux-sr-4x4-roja-2024-n009c5e$ /catalogo/detalle/toyota-hilux-sr-4x4-roja-2024-65 [R=301,L]
  RewriteRule ^catalogo/detalle/toyota-raize-4x2-12-gris-2025-n19ef1e$ /catalogo/detalle/toyota-raize-4x2-12-gris-2025-82 [R=301,L]
  RewriteRule ^catalogo/detalle/ford-ranger-4x4-rojo-2023-n5f603a$ /catalogo/detalle/ford-ranger-4x4-rojo-2023-53 [R=301,L]
