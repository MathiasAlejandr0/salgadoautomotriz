# Salgado Automotriz · HostGator (Apache)
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + sin www
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://salgadoautomotriz.cl%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # sitemap dinámico (MySQL) y verificación de Search Console por archivo
  RewriteRule ^sitemap\.xml$ api/index.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^google[a-z0-9]+\.html$ api/index.php [L]

  # API PHP
  RewriteRule ^api/(_lib|_cron)(/|$) - [F,L]
  RewriteRule ^api/(.+)$ api/index.php [QSA,L]

  # Quitar barra final (excepto raíz)
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # URL vieja con patente -> slug público, en este mismo dominio.
  # El build rellena las reglas. Si falta una, api/index.php decide 301, 410 o 404.
  # BEGIN plate-redirects
  RewriteRule ^catalogo/detalle/chevrolet-tracker-2022-rzkv76$ /catalogo/detalle/chevrolet-tracker-blanco-2022-299 [R=301,L]
  RewriteRule ^catalogo/detalle/hyundai-creta-su2id-cvt-2024-tsbp57$ /catalogo/detalle/hyundai-creta-su2id-cvt-plateado-2024-315 [R=301,L]
  RewriteRule ^catalogo/detalle/citroen-c3-hb-12-aut-2019-kysg80$ /catalogo/detalle/citroen-c3-hb-12-aut-gris-platinium-blanco-2019-332 [R=301,L]
  RewriteRule ^catalogo/detalle/ssangyong-new-rexton-lx-4x4-20-aut-2023-spxg35$ /catalogo/detalle/ssangyong-new-rexton-lx-4x4-20-aut-azul-2023-316 [R=301,L]
  RewriteRule ^catalogo/detalle/peugeot-partner-vu-hdi-16-2019-ldfy41$ /catalogo/detalle/peugeot-partner-vu-hdi-16-blanco-2019-322 [R=301,L]
  RewriteRule ^catalogo/detalle/suzuki-baleno-gls-hb-14-2019-kvgk53$ /catalogo/detalle/suzuki-baleno-gls-hb-14-azul-2019-306 [R=301,L]
